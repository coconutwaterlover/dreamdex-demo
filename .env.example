# Somnia Shannon (chain ID 50312)
NEXT_PUBLIC_SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
DREAMDEX_API_URL=https://stg.api.dreamdex.io/v0

# ---------------------------------------------------------------- arena stack
# Deploy all four with: npm run deploy:arena
NEXT_PUBLIC_ARENA_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DESK_BADGE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONTRIBUTOR_BADGE_ADDRESS=0x0000000000000000000000000000000000000000
# Self-rescheduling Reactivity clock. Needs >= 32 STT of its own to hold a subscription.
NEXT_PUBLIC_ARENA_CLOCK_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------- keys
# Session / keeper key: deploys the arena and mirrors armed desks onto the real book.
# The address is public; the private key is server-only and must never be NEXT_PUBLIC_.
NEXT_PUBLIC_SESSION_ADDRESS=0x0000000000000000000000000000000000000000
SESSION_PRIVATE_KEY=

# Demo desk owner (cold side of the split). Only needed to seed a live house desk.
NEXT_PUBLIC_HOUSE_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
HOUSE_OWNER_PRIVATE_KEY=

# Public origin used as the ERC-721 tokenURI base (https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=
