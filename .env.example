# Somnia Shannon (chain ID 50312)
NEXT_PUBLIC_SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
DREAMDEX_API_URL=https://stg.api.dreamdex.io/v0

# House desk — owner EOA that grants/revokes the session key
NEXT_PUBLIC_HOUSE_OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Hot session key address (public) + private key (server only, never NEXT_PUBLIC_)
NEXT_PUBLIC_SESSION_ADDRESS=0x0000000000000000000000000000000000000000
SESSION_PRIVATE_KEY=

# RoundClock handler (Somnia Reactivity). Deploy with: npm run deploy:clock
# Session key must hold ≥ 32 STT to create the on-chain Schedule subscription.
NEXT_PUBLIC_ROUND_CLOCK_ADDRESS=0x0000000000000000000000000000000000000000

# Soulbound leaderboard badges. Deploy with: npm run deploy:badge (minter = session key)
NEXT_PUBLIC_DESK_BADGE_ADDRESS=0x0000000000000000000000000000000000000000
# Public origin used as ERC-721 tokenURI base (https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=
